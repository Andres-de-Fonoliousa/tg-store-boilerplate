# ─── البوت ────────────────────────────────────────────────────
# توكن البوت من @BotFather
BOT_TOKEN=

# أرقام المشرفين (Telegram IDs) مفصولة بفواصل — مثال: 123456789,987654321
ADMIN_USER_IDS=

# اللغة: ar | en (القيم الافتراضية بالعربية)
LANG=ar

# ─── قاعدة البيانات ───────────────────────────────────────────
# sqlite:///./store.db أو postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./store.db

# ─── المزوّد ──────────────────────────────────────────────────
# world4card | dummy
STORE_PROVIDER=world4card

# عنوان API (نمط World4Card / shams4store)
PROVIDER_BASE_URL=https://api.world4card.com
# توكن API (يُرسل في رأس api-token)
PROVIDER_API_TOKEN=

# ─── الأسعار ──────────────────────────────────────────────────
# هامش الربح النسبة المئوية المضافة على التكلفة (مثال: 20 = +20%)
MARGIN_PERCENT=20

# ─── الإشعارات والمهام ────────────────────────────────────────
# تنبيه الأدمن عند انخفاض رصيد المزوّد
PROVIDER_LOW_BALANCE_THRESHOLD=5.0
# مزامنة الكتالوج تلقائياً (دقائق، 0 = تعطيل)
CATALOG_SYNC_MINUTES=60

# ─── لوحة الإدارة (اختيارية) ──────────────────────────────────
# مفتاح توقيع الجلسات — قيمة عشوائية طويلة!
# توليد: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# رمز دخول اللوحة (يُخزّن كهاش عند أول استخدام)
ADMIN_ACCESS_CODE=

# 127.0.0.1 افتراضياً — ضع 0.0.0.0 فقط خلف nginx على VPS
ADMIN_HOST=127.0.0.1
ADMIN_PORT=5000